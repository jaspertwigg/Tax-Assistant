rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['country', 'currency', 'situation', 'mileageRate', 'distanceUnit']);

      match /receipts/{receiptId} {
        allow read, delete: if isOwner(uid);
        // Files must live under the owner's own storage folder; the scan function relies on this.
        allow create, update: if isOwner(uid)
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('users/' + uid + '/receipts/' + receiptId + '/.*');
      }

      // Written only by the chat Cloud Function; the owner can read and clear them.
      match /chatMessages/{messageId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /income/{id} {
        allow read, write: if isOwner(uid);
      }
      match /mileage/{id} {
        allow read, write: if isOwner(uid);
      }
      match /reminders/{id} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
